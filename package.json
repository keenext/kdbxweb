{
  "name": "@keenext/kdbxweb",
  "version": "2.2.0-keenext.2",
  "description": "Fork of keeweb/kdbxweb maintained for KeeNext, see FORK.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenext/kdbxweb.git"
  },
  "bugs": {
    "url": "https://github.com/keenext/kdbxweb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "FORK.md"
  ],
  "scripts": {
    "build": "esbuild lib/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:fflate --sourcemap --outfile=dist/index.js && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/expect.js": "^0.3.32",
    "@types/node": "^24.19.1",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "expect.js": "^0.3.1",
    "hash-wasm": "^4.12.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
